rules_version = '2';

// ITE 413 Lab 4 - laboratory-only rules.
// Anyone who knows the project id can read/write the menuItems collection.
// Replace these with authenticated, validated rules before any real use.
service cloud.firestore {
  match /databases/{database}/documents {
    match /menuItems/{itemId} {
      allow read, write: if true;
    }
  }
}
