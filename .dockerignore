# Keep the Docker build context small and free of host-specific artifacts.
node_modules
.git
.gitignore
.angular
www
coverage
dist
tmp
out-tsc

# Local environment files can contain secrets. Firebase web config belongs in
# src/environments/environment.ts, not in a .env file, for this lab.
.env
.env.*

# Logs and editor state
*.log
.vscode
.idea

# Test/report artifacts do not need to be inside the runtime image.
docs
scripts
