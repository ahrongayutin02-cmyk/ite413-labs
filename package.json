    "@angular/router": "22.2.5",
    "@ionic/angular": "^9.0.0",
    "firebase": "^13.3.0",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
